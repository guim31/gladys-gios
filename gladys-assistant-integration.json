{
  "manifest_version": 1,
  "type": "device",
  "name": "GIOŚ",
  "description": {
    "en": "Air quality of the official Polish GIOŚ stations: index and pollutants, hour by hour.",
    "fr": "Qualité de l'air des stations officielles polonaises du GIOŚ : indice et polluants, heure par heure.",
    "de": "Luftqualität der offiziellen polnischen GIOŚ-Stationen: Index und Schadstoffe, stündlich.",
    "es": "Calidad del aire de las estaciones oficiales polacas de GIOŚ: índice y contaminantes, cada hora."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-gios:1.0.0",
  "gladys_version": ">=5.3.0",
  "countries": ["PL"],
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-gios/main/cover.png",
  "categories": ["environment"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Polish air quality stations",
        "fr": "Stations polonaises de qualité de l'air",
        "de": "Polnische Luftqualitätsstationen",
        "es": "Estaciones polacas de calidad del aire"
      },
      "description": {
        "en": "Reads the official measuring stations of GIOŚ, the Polish Chief Inspectorate of Environmental Protection, through its open API (no account). Not affiliated with GIOŚ.",
        "fr": "Lit les stations de mesure officielles du GIOŚ, l'inspection générale polonaise de l'environnement, par son API ouverte (sans compte). Non affilié au GIOŚ.",
        "de": "Liest die offiziellen Messstationen von GIOŚ, der polnischen Hauptinspektion für Umweltschutz, über ihre offene API (ohne Konto). Nicht mit GIOŚ verbunden.",
        "es": "Lee las estaciones de medición oficiales de GIOŚ, la Inspección General de Protección del Medio Ambiente de Polonia, mediante su API abierta (sin cuenta). Sin afiliación con GIOŚ."
      },
      "links": [
        {
          "url": "https://powietrze.gios.gov.pl/pjp/current",
          "label": {
            "en": "Map of the stations",
            "fr": "Carte des stations",
            "de": "Karte der Stationen",
            "es": "Mapa de las estaciones"
          }
        },
        {
          "url": "https://powietrze.gios.gov.pl/pjp/content/api",
          "label": {
            "en": "The GIOŚ API",
            "fr": "L'API du GIOŚ",
            "de": "Die GIOŚ-API",
            "es": "La API de GIOŚ"
          }
        }
      ]
    },
    {
      "key": "stations",
      "type": "string",
      "label": {
        "en": "Stations",
        "fr": "Stations",
        "de": "Stationen",
        "es": "Estaciones"
      },
      "description": {
        "en": "The numbers of the GIOŚ stations to read, separated by commas (10 at most). The \"Find a station\" button below gives them, by name or around a house.",
        "fr": "Les numéros des stations du GIOŚ à lire, séparés par des virgules (10 au plus). Le bouton « Trouver une station » ci-dessous les donne, par nom ou autour d'une maison.",
        "de": "Die Nummern der zu lesenden GIOŚ-Stationen, durch Kommas getrennt (höchstens 10). Der Button „Station finden“ unten liefert sie, nach Name oder in der Nähe eines Hauses.",
        "es": "Los números de las estaciones de GIOŚ que desea leer, separados por comas (10 como máximo). El botón «Buscar una estación» más abajo se los da, por nombre o alrededor de una casa."
      },
      "placeholder": {
        "en": "e.g. 530, 401",
        "fr": "ex. 530, 401",
        "de": "z. B. 530, 401",
        "es": "p. ej. 530, 401"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "refresh_minutes",
      "type": "select",
      "label": {
        "en": "Refresh",
        "fr": "Relevé",
        "de": "Abruf",
        "es": "Lectura"
      },
      "description": {
        "en": "GIOŚ publishes hourly averages, a little after each hour.",
        "fr": "Le GIOŚ publie des moyennes horaires, un peu après chaque heure.",
        "de": "GIOŚ veröffentlicht Stundenmittel, kurz nach jeder vollen Stunde.",
        "es": "GIOŚ publica medias horarias, poco después de cada hora."
      },
      "required": false,
      "default": "30",
      "options": [
        {
          "value": "30",
          "label": {
            "en": "Every 30 minutes",
            "fr": "Toutes les 30 minutes",
            "de": "Alle 30 Minuten",
            "es": "Cada 30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "Every hour",
            "fr": "Toutes les heures",
            "de": "Jede Stunde",
            "es": "Cada hora"
          }
        }
      ]
    },
    {
      "key": "language",
