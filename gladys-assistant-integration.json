  "actions": [
    {
      "key": "find_station",
      "label": {
        "en": "Find a station",
        "fr": "Trouver une station",
        "de": "Station finden",
        "es": "Buscar una estación"
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "query",
          "type": "string",
          "label": {
            "en": "Name or city",
            "fr": "Nom ou ville",
            "de": "Name oder Stadt",
            "es": "Nombre o ciudad"
          },
          "description": {
            "en": "Accents are optional. Empty: the stations nearest to the house.",
            "fr": "Les accents sont facultatifs. Vide : les stations les plus proches de la maison.",
            "de": "Akzente sind optional. Leer: die Stationen, die dem Haus am nächsten sind.",
            "es": "Los acentos son opcionales. Vacío: las estaciones más cercanas a la casa."
          },
          "placeholder": {
            "en": "e.g. Kraków",
            "fr": "ex. Kraków",
            "de": "z. B. Kraków",
            "es": "p. ej. Kraków"
          },
          "required": false
        },
        {
          "key": "house",
          "type": "select",
          "source": "houses",
          "label": {
            "en": "House",
            "fr": "Maison",
            "de": "Haus",
            "es": "Casa"
          },
          "description": {
            "en": "Sorts by distance. Its location is set in Settings → Houses. Empty: the first located house when no name is typed.",
            "fr": "Trie par distance. Sa position se règle dans Paramètres → Maisons. Vide : la première maison située si aucun nom n'est saisi.",
            "de": "Sortiert nach Entfernung. Sein Standort wird unter Einstellungen → Zuhause festgelegt. Leer: das erste Haus mit Standort, wenn kein Name eingegeben ist.",
            "es": "Ordena por distancia. Su ubicación se define en Configuración → Viviendas. Vacío: la primera casa con ubicación si no escribe ningún nombre."
          },
          "required": false
        }
      ]
    },
    {
      "key": "check_stations",
      "label": {
        "en": "Check the stations",
        "fr": "Vérifier les stations",
        "de": "Stationen prüfen",
        "es": "Comprobar las estaciones"
      },
      "timeout_seconds": 120
    }
  ],
